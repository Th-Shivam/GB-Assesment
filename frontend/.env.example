# Public browser setting, baked into a Vite build. Never put credentials here.
# Local development uses the Vite proxy; production requires an absolute HTTPS URL.
VITE_API_BASE_URL=/backend

# Production example (replace with the deployed backend origin before building):
# VITE_API_BASE_URL=https://api.example.com

# Server-side Vite setting only; restart Vite after changing environment values.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
