# Public Elexon GET requests need no API key.
# Defaults describe an analytical scenario, NOT the customer's procurement policy.
WIND_DEFAULT_MARKET=n2ex
# Optional HH:MM UK internal decision time, no later than the selected market gate:
# WIND_INTERNAL_DECISION_TIME=09:00
WIND_CUTOFF_INCLUSIVE=true
# Keep unverified unless the hourly-average interpretation is explicitly accepted.
WIND_COMPARISON_MODE=unverified
WIND_LOOKBACK_DAYS=3
WIND_CACHE_TTL_SECONDS=3600
WIND_CACHE_MAX_ENTRIES=128
WIND_UPSTREAM_TIMEOUT_SECONDS=30
WIND_UPSTREAM_CONCURRENCY=4
WIND_UPSTREAM_RETRIES=3
WIND_MAX_RETRY_WAIT_SECONDS=30
